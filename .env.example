# ─── BusinessGPT Root Environment Variables ───

# PostgreSQL Database (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=businessgpt

# AI Services
GROQ_API_KEY=gsk_your_groq_api_key_here

# Market Intelligence (Optional)
NEWSAPI_KEY=your_newsapi_key_here

# WhatsApp Integration (Optional - Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Frontend & Embedding URLs (Defaults work out-of-the-box for Docker Compose)
FRONTEND_URL=http://localhost:3000
OLLAMA_BASE_URL=http://ollama:11434
