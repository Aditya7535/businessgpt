# ==============================================================================
# BusinessGPT Backend Configuration Example
# Copy this file to `backend/.env` and replace placeholders with your actual keys.
# Never commit `.env` containing real production secrets.
# ==============================================================================

# Database Connection (PostgreSQL with pg8000 driver; falls back to SQLite businessgpt.db if offline)
DATABASE_URL=postgresql+pg8000://postgres:YOUR_PASSWORD@localhost:5432/businessgpt

# Groq Cloud API (Required for Text-to-SQL Co-Pilot, Consultative LLM, and Whisper Voice)
GROQ_API_KEY=your_groq_api_key_here

# Voice Input (Groq Whisper configuration)
GROQ_WHISPER_MODEL=whisper-large-v3
MAX_AUDIO_UPLOAD_SIZE_MB=25

# Market Intelligence / News API (Optional)
NEWSAPI_KEY=your_newsapi_key_here

# ------------------------------------------------------------------------------
# Twilio WhatsApp Business Integration
# ------------------------------------------------------------------------------
# Twilio Account SID and Auth Token from Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp sender number.
# For Twilio Sandbox: whatsapp:+14155238886
# For Approved WhatsApp Business Sender: whatsapp:+91XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Public HTTPS URL of your backend used for Twilio Webhook Signature Validation
# For local development with ngrok: https://your-subdomain.ngrok-free.app
# Twilio Console Webhook Target: <WHATSAPP_WEBHOOK_BASE_URL>/api/whatsapp/webhook
WHATSAPP_WEBHOOK_BASE_URL=https://your-domain.ngrok-free.app

# Proactive Morning Business Summary Digest (APScheduler)
WHATSAPP_DAILY_DIGEST_ENABLED=false
WHATSAPP_DAILY_DIGEST_TIME=09:00
WHATSAPP_STORE_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# Frontend & Deployment Settings
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=*
PORT=8000
